# Local development
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Microsoft button on login (same idea as ACE Outsource). false hides/disables it.
# Backend still needs AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET.
NEXT_PUBLIC_LOGIN=true

# Demo / docs live links use NEXT_PUBLIC_APP_URL + NEXT_PUBLIC_API_URL
# Demo guide unlock is verified server-side (POST /auth/verify-demo-access).
# Set DEMO_ACCESS_CODE on the API to the shared guide password (do not put secrets in NEXT_PUBLIC_*).
# Optional local-only fallback (dev when API code unset) — leave empty in production builds:
# NEXT_PUBLIC_DEMO_GUIDE_ACCESS_PASSWORD=


# Production values for Azure SWA deploy live in gitignored `.env.deploy`
# (see `.env.deploy.example` + `npm run deploy:azure`). Do not flip this file by hand.
