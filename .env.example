# Local development
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Microsoft button on login (same idea as ACE Outsource). false hides/disables it.
# Backend still needs AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET.
NEXT_PUBLIC_LOGIN=true

# Demo / docs live links use NEXT_PUBLIC_APP_URL + NEXT_PUBLIC_API_URL
# Demo guide unlock is verified server-side only (POST /auth/verify-demo-access).
# Set DEMO_ACCESS_CODE on the API — never put that secret in NEXT_PUBLIC_*.

# Optional: invoice parse UI toggle
# NEXT_PUBLIC_ENABLE_INVOICE_PARSE=false

# Demo Guide training videos (Azure Blob private container + read SAS — not invoice storage)
# Upload: npm run docs:upload-videos  (prints BASE_URL + SAS)
# NEXT_PUBLIC_DOCS_VIDEOS_BASE_URL=https://acefinance.blob.core.windows.net/ace-finance-docs-videos
# NEXT_PUBLIC_DOCS_VIDEOS_SAS=sv=...&ss=...&srt=...&sp=r&...

# Production values for Azure SWA deploy live in gitignored `.env.deploy`
# (see `.env.deploy.example` + `npm run deploy:azure`).
