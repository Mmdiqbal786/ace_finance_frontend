{
  "name": "ace_finance_frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve@14 out",
    "lint": "eslint",
    "deploy:azure": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-azure-swa.ps1",
    "test:e2e": "playwright test --grep-invert \"@mfa|@docs\"",
    "test:e2e:vapt": "playwright test --grep @vapt --grep-invert @mfa",
    "test:e2e:mfa": "playwright test --grep @mfa --headed",
    "test:e2e:docs": "playwright test -c playwright.docs.config.ts --headed",
    "docs:publish-videos": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-docs-videos.ps1",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "next": "16.2.10",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
